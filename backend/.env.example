PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/civivigi

# JWT
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d

# Seed admin (created by `npm run seed`)
SEED_ADMIN_EMAIL=admin@civivigi.org
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Super Admin

# Twilio (WhatsApp messaging + voice calls) — leave blank to run in mocked/console-log mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=+15005550006
# TwiML endpoint Twilio will call back to fetch what to say on the WhatsApp call.
# Must be a publicly reachable URL of this API in production.
PUBLIC_BASE_URL=http://localhost:5000

# Social media (mocked/console-log mode when blank)
TWITTER_BEARER_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# USSD
USSD_SESSION_TTL_MS=120000
